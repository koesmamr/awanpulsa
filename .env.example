# ==============================================================================
# TEMPLATE KONFIGURASI SERVER & SISTEM AWANPULSA (.env)
# ==============================================================================
PORT=3002
NODE_ENV=production
APP_NAME=Awan Pulsa
DOMAIN_NAME=awanpulsa.web.id

# Akun Administrator
ADMIN_EMAIL=admin@awanpulsa.web.id
BACKUP_PASSWORD=AwanPulsa2026Secure!

# Google OAuth Sign-In (Client ID & Secret)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Toko Gorontalo H2H PPOB Client (Isi dengan akun Gorontalo baru Anda)
TOKOGORONTALO_BASE_URL=https://app.tupo.my.id
TOKOGORONTALO_USERID=your_userid
TOKOGORONTALO_PIN=your_pin
TOKOGORONTALO_PASS=your_password

# AutoGoPay (ShopeePay & GoPay QRIS Otomatis)
AUTOGOPAY_API_KEY=your_autogopay_api_key
SHOPEEPAY_QRIS_STATIC=000201010211...
GOPAY_QRIS_STATIC=000201010211...

# Telegram Bot Notification (Disarankan gunakan bot & channel khusus AwanPulsa)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_ADMIN_ID=1234567890
TELEGRAM_GROUP_THREAD_ID=1

# Google AI (Gemini) & DeepSeek
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Email Notification via Google Apps Script (GAS)
GAS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbznmzNY0ewVAmsqz5NH-ulHb_YyI9JNmNwwCILOWSDTawDn9tEXSy_l3b3Vw2gHHwIJ-g/exec
GAS_SECRET_TOKEN=RahasiaVPNtuban123!

# Payment Gateway Tambahan (TriPay & Violet)
TRIPAY_MERCHANT_CODE=T00000
TRIPAY_API_KEY=your_tripay_api_key
TRIPAY_PRIVATE_KEY=your_tripay_private_key
VIOLET_API_KEY=your_violet_api_key
VIOLET_SECRET_KEY=your_violet_secret_key
